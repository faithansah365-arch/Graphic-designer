# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional Resend API key for delivering contact form inquiries directly to your email.
# Obtain a free key at https://resend.com
RESEND_API_KEY=""

# FORMSPREE_ENDPOINT: Formspree form submission endpoint
FORMSPREE_ENDPOINT="https://formspree.io/f/xvkkwewd"

# OWNER_EMAIL: The destination email address to receive design inquiries from the contact form.
OWNER_EMAIL="contact@keingraphics.com"
