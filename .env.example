# Obtain a free key at https://resend.com
RESEND_API_KEY=""

# OWNER_EMAIL: The destination email address to receive design inquiries from the contact form.
# Default: faithansah365@gmail.com
OWNER_EMAIL="faithansah365@gmail.com"
